{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "World Forge Entities",
  "description": "Schema for entities.toml files",
  "type": "object",
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "entity_type", "region"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "entity_type": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "initial_inventory": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "production": {
            "type": "object",
            "properties": {
              "inputs": {
                "type": "object",
                "additionalProperties": { "type": "number", "minimum": 0 }
              },
              "outputs": {
                "type": "object",
                "additionalProperties": { "type": "number", "minimum": 0 }
              },
              "energy_cost": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "resource", "max_per_tick"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "resource": { "type": "string", "minLength": 1 },
          "max_per_tick": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
