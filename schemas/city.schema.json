{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "World Forge City Systems",
  "description": "Schema for optional city.toml construction, district, population, and research rules",
  "type": "object",
  "required": ["treasury", "districts", "buildings"],
  "properties": {
    "treasury": { "$ref": "#/definitions/id" },
    "population_resource": { "$ref": "#/definitions/id" },
    "population_growth_per_tick": { "type": "number", "minimum": 0 },
    "population_needs": { "$ref": "#/definitions/resources" },
    "districts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "slots"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "slots": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "allowed_districts"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "tags": { "$ref": "#/definitions/ids" },
          "allowed_districts": { "$ref": "#/definitions/ids" },
          "footprint": { "type": "integer", "minimum": 1 },
          "max_count": { "type": "integer", "minimum": 1 },
          "cost": { "$ref": "#/definitions/resources" },
          "upkeep": { "$ref": "#/definitions/resources" },
          "outputs": { "$ref": "#/definitions/resources" },
          "housing": { "type": "integer", "minimum": 0 },
          "jobs": { "type": "integer", "minimum": 0 },
          "wellbeing": { "type": "number", "minimum": 0 },
          "requires_technologies": { "$ref": "#/definitions/ids" },
          "synergies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["with_tag", "output_multiplier"],
              "properties": {
                "with_tag": { "$ref": "#/definitions/id" },
                "output_multiplier": { "type": "number", "minimum": 1, "maximum": 10 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "branch"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "branch": { "type": "string", "minLength": 1 },
          "cost": { "$ref": "#/definitions/resources" },
          "prerequisites": { "$ref": "#/definitions/ids" },
          "excludes": { "$ref": "#/definitions/ids" },
          "effects": {
            "type": "object",
            "properties": {
              "resource_multipliers": { "$ref": "#/definitions/multipliers" },
              "building_multipliers": { "$ref": "#/definitions/multipliers" },
              "housing_multiplier": { "type": "number", "minimum": 0.1, "maximum": 10 },
              "jobs_multiplier": { "type": "number", "minimum": 0.1, "maximum": 10 },
              "wellbeing_bonus": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "initial_support": { "type": "number", "minimum": 0, "maximum": 100 }
        },
        "additionalProperties": false
      }
    },
    "dilemmas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "options"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "deadline_ticks": { "type": "integer", "minimum": 1 },
          "default_option": { "$ref": "#/definitions/id" },
          "trigger": { "$ref": "#/definitions/civicTrigger" },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/definitions/civicOption" }
          }
        },
        "additionalProperties": false
      }
    },
    "political_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "power_structure": { "type": "string" },
          "ruler_title": { "type": "string" },
          "initial_stance": { "type": "string" },
          "initial_loyalty": { "type": "number", "minimum": 0, "maximum": 100 },
          "military_power": { "type": "number", "minimum": 0 },
          "tribute": { "$ref": "#/definitions/resources" },
          "traits": { "$ref": "#/definitions/ids" }
        },
        "additionalProperties": false
      }
    },
    "corporations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "secrets"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "sector": { "type": "string", "minLength": 1 },
          "security": { "type": "number", "minimum": 0, "maximum": 100 },
          "influence": { "type": "number", "minimum": 0, "maximum": 100 },
          "secrets": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/tradeSecret" }
          }
        },
        "additionalProperties": false
      }
    },
    "cyber_agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "skill": { "type": "number", "minimum": 0, "maximum": 100 },
          "stealth": { "type": "number", "minimum": 0, "maximum": 100 },
          "loyalty": { "type": "number", "minimum": 0, "maximum": 100 },
          "containment": { "type": "number", "minimum": 0, "maximum": 100 },
          "initial_status": { "enum": ["ready", "contained", "compromised", "rogue"] }
        },
        "additionalProperties": false
      }
    },
    "crypto_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "symbol", "initial_price"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 12 },
          "initial_price": { "type": "number", "exclusiveMinimum": 0 },
          "volatility": { "type": "number", "minimum": 0, "maximum": 1 },
          "liquidity": { "type": "number", "exclusiveMinimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$" },
    "ids": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
    "resources": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
    "multipliers": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0.1, "maximum": 10 } },
    "signedResources": { "type": "object", "additionalProperties": { "type": "number", "minimum": -100, "maximum": 100 } },
    "choices": { "type": "object", "additionalProperties": { "$ref": "#/definitions/id" } },
    "civicTrigger": {
      "type": "object",
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "resource_below": { "$ref": "#/definitions/resources" },
        "resource_above": { "$ref": "#/definitions/resources" },
        "trajectory_below": { "$ref": "#/definitions/signedResources" },
        "trajectory_above": { "$ref": "#/definitions/signedResources" },
        "requires_technologies": { "$ref": "#/definitions/ids" },
        "requires_choices": { "$ref": "#/definitions/choices" },
        "excludes_choices": { "$ref": "#/definitions/choices" }
      },
      "additionalProperties": false
    },
    "civicEffects": {
      "type": "object",
      "properties": {
        "resource_multipliers": { "$ref": "#/definitions/multipliers" },
        "building_multipliers": { "$ref": "#/definitions/multipliers" },
        "housing_multiplier": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "jobs_multiplier": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "population_growth_multiplier": { "type": "number", "minimum": 0.1, "maximum": 10 },
        "wellbeing_bonus": { "type": "number" }
      },
      "additionalProperties": false
    },
    "civicOption": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "cost": { "$ref": "#/definitions/resources" },
        "grants": { "$ref": "#/definitions/resources" },
        "faction_support": { "$ref": "#/definitions/signedResources" },
        "trajectory": { "$ref": "#/definitions/signedResources" },
        "effects": { "$ref": "#/definitions/civicEffects" }
      },
      "additionalProperties": false
    },
    "tradeSecret": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "difficulty": { "type": "number", "minimum": 0, "maximum": 100 },
        "research_value": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
