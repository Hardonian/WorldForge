{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "World Forge World Manifest",
  "description": "Schema for world.toml manifest files",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique name for this world",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "description": "Human-readable description"
    },
    "version": {
      "type": "string",
      "description": "SemVer version string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "extends": {
      "type": "array",
      "description": "Slug-safe sibling world directory IDs, applied in declaration order",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-z0-9_](?:[a-z0-9_-]*[a-z0-9_])?$"
      }
    },
    "mods": {
      "type": "array",
      "description": "Mod packages to apply",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
